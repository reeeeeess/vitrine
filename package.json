{
  "name": "vitrine-pc",
  "productName": "Vitrine",
  "version": "0.3.0",
  "private": true,
  "description": "Lecteur Spotify de bureau au design verre, sur l'API officielle de Spotify.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/archivo-black": "5.2.8",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@types/node": "22.18.6",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "clsx": "2.1.1",
    "electron": "github:castlabs/electron-releases#v43.7.7+wvcus",
    "electron-builder": "26.0.12",
    "electron-updater": "6.6.2",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "esbuild": "0.25.10",
    "framer-motion": "11.11.10",
    "lucide-react": "0.344.0",
    "postcss": "8.5.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "3.4.18",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  },
  "build": {
    "appId": "fr.vitrine.desktop",
    "productName": "Vitrine",
    "electronVersion": "43.7.7+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "afterPack": "scripts/evs-sign.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Vitrine-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "Vitrine-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "reeeeeess",
        "repo": "vitrine",
        "releaseType": "release"
      }
    ]
  },
  "author": {
    "name": "Vitrine",
    "email": "a.ennaidi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reeeeeess/vitrine.git"
  }
}
